    "\n",
    "# TODO: Objective fonksiyonu yaz (toplam faydayı maximize et)\n",
    "# prob += ...\n",
    "\n",
    "# TODO: AKTS kısıtını yaz\n",
    "# prob += ...\n",
    "\n",
    "# TODO: Çöz\n",
    "# prob.solve(pulp.PULP_CBC_CMD(msg=0))\n",
