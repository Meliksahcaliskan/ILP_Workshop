   "source": [
    "# 03 — Alıştırma Çözümü: Seçmeli Ders Seçimi\n",
    "\n",
    "> **Bu dosya `solutions` branch'indedir. Workshop sırasında `main` branch'ini kullanın.**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "if \"google.colab\" in sys.modules:\n",
    "    !pip install -q "pulp>=2.8.0"\n",
    "    !git clone -q -b solutions https://github.com/Meliksahcaliskan/ILP_Workshop.git\n",
    "    sys.path.insert(0, \"ILP_Workshop\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "import pulp\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom utils.plotting import show_status, plot_knapsack_comparison, plot_efficiency_chart"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "courses = [\"A\", \"B\", \"C\", \"D\"]\n",
    "names   = {\"A\": \"Yapay Zekâya Giriş\", \"B\": \"Bilgisayar Grafikleri\",\n",
    "           \"C\": \"Mobil Programlama\",  \"D\": \"Teknik İngilizce\"}\n",
    "akts    = {\"A\": 8, \"B\": 7, \"C\": 7, \"D\": 4}\n",
    "value   = {\"A\": 30, \"B\": 20, \"C\": 20, \"D\": 8}\n",
    "hours   = {\"A\": 4, \"B\": 3, \"C\": 3, \"D\": 2}\n",
    "AKTS_LIMIT = 14\n",
    "\n",
    "\n",
    "def greedy_selection(courses, akts, value, limit):\n",
    "    sorted_courses = sorted(courses, key=lambda c: value[c] / akts[c], reverse=True)\n",
    "    selected, remaining = [], limit\n",
    "    for c in sorted_courses:\n",
    "        if akts[c] <= remaining:\n",
    "            selected.append(c)\n",
    "            remaining -= akts[c]\n",
    "    return selected\n",
    "\n",
    "\n",
    "greedy_result = greedy_selection(courses, akts, value, AKTS_LIMIT)\n",
    "print(f\"Greedy: {greedy_result}, fayda={sum(value[c] for c in greedy_result)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Temel ILP Çözümü"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "prob = pulp.LpProblem(\"course_selection\", pulp.LpMaximize)\n\n# ✅ Binary değişkenler\nx = {c: pulp.LpVariable(f\"x_{c}\", cat=\"Binary\") for c in courses}\n\n# ✅ Objective\nprob += pulp.lpSum(value[c] * x[c] for c in courses)\n\n# ✅ AKTS kısıtı\nprob += pulp.lpSum(akts[c] * x[c] for c in courses) <= AKTS_LIMIT\n\nprob.solve(pulp.PULP_CBC_CMD(msg=0))\nshow_status(prob)\n\nilp_result = [c for c in courses if pulp.value(x[c]) > 0.5]\nilp_value  = int(pulp.value(prob.objective))\nprint(f\"ILP : {ilp_result}, fayda={ilp_value}\")\n\nfig = plot_knapsack_comparison(greedy_result, ilp_result, courses, akts, value, names)\nplt.show()\n\n# Beklenen: B+C, fayda=40\nassert ilp_value == 40, f\"Beklenen fayda 40, alınan {ilp_value}\"\nprint(\"✅ Sonuç doğrulandı: B+C, fayda=40\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ek Görev 1 — Önkoşul (B alınırsa D de alınmalı)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "prob_ek1 = pulp.LpProblem(\"prereq\", pulp.LpMaximize)\nx1 = {c: pulp.LpVariable(f\"x_{c}\", cat=\"Binary\") for c in courses}\n\nprob_ek1 += pulp.lpSum(value[c] * x1[c] for c in courses)\nprob_ek1 += pulp.lpSum(akts[c] * x1[c] for c in courses) <= AKTS_LIMIT\nprob_ek1 += x1[\"B\"] <= x1[\"D\"]\n\nprob_ek1.solve(pulp.PULP_CBC_CMD(msg=0))\nshow_status(prob_ek1)\nr1 = [c for c in courses if pulp.value(x1[c]) > 0.5]\nv1 = int(pulp.value(prob_ek1.objective))\nprint(f\"Ek Görev 1: {r1}, fayda={v1}\")\n# Beklenen: A+D, fayda=38\nassert v1 == 38, f\"Beklenen 38, alınan {v1}\"\nprint(\"✅ Doğrulandı: A+D, fayda=38\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ek Görev 2 — Saat Çakışması (B ve C birlikte alınamaz)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "prob_ek2 = pulp.LpProblem(\"conflict\", pulp.LpMaximize)\nx2 = {c: pulp.LpVariable(f\"x_{c}\", cat=\"Binary\") for c in courses}\n\nprob_ek2 += pulp.lpSum(value[c] * x2[c] for c in courses)\nprob_ek2 += pulp.lpSum(akts[c] * x2[c] for c in courses) <= AKTS_LIMIT\nprob_ek2 += x2[\"B\"] + x2[\"C\"] <= 1\n\nprob_ek2.solve(pulp.PULP_CBC_CMD(msg=0))\nshow_status(prob_ek2)\nr2 = [c for c in courses if pulp.value(x2[c]) > 0.5]\nv2 = int(pulp.value(prob_ek2.objective))\nprint(f\"Ek Görev 2: {r2}, fayda={v2}\")\n# Beklenen: A+D, fayda=38\nassert v2 == 38, f\"Beklenen 38, alınan {v2}\"\nprint(\"✅ Doğrulandı: A+D, fayda=38\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ek Görev 3 — İkinci Kaynak: Haftalık Saat Limiti (5 saat)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "HOUR_LIMIT = 5\n\nprob_ek3 = pulp.LpProblem(\"2d_knapsack\", pulp.LpMaximize)\nx3 = {c: pulp.LpVariable(f\"x_{c}\", cat=\"Binary\") for c in courses}\n\nprob_ek3 += pulp.lpSum(value[c] * x3[c] for c in courses)\nprob_ek3 += pulp.lpSum(akts[c]  * x3[c] for c in courses) <= AKTS_LIMIT\nprob_ek3 += pulp.lpSum(hours[c] * x3[c] for c in courses) <= HOUR_LIMIT\n\nprob_ek3.solve(pulp.PULP_CBC_CMD(msg=0))\nshow_status(prob_ek3)\nr3 = [c for c in courses if pulp.value(x3[c]) > 0.5]\nv3 = int(pulp.value(prob_ek3.objective))\nprint(f\"Ek Görev 3: {r3}, fayda={v3}\")\n# Beklenen: yalnızca A, fayda=30\nassert v3 == 30, f\"Beklenen 30, alınan {v3}\"\nprint(\"✅ Doğrulandı: yalnızca A, fayda=30\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Ek Görev 4 — Ölçek Testi (30 ders)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import random, time\n",
    "\n",
    "random.seed(42)\n",
    "N = 30\n",
    "big_courses = list(range(N))\n",
    "big_akts    = {i: random.randint(2, 10) for i in big_courses}\n",
    "big_value   = {i: random.randint(5, 50) for i in big_courses}\n",
    "BIG_LIMIT   = 40\n",
    "\n",
    "\n",
    "def greedy_selection_generic(courses, akts, value, limit):\n",
    "    sorted_courses = sorted(courses, key=lambda c: value[c] / akts[c], reverse=True)\n",
    "    selected, remaining = [], limit\n",
    "    for c in sorted_courses:\n",
    "        if akts[c] <= remaining:\n",
    "            selected.append(c)\n",
    "            remaining -= akts[c]\n",
    "    return selected\n",
    "\n",
    "\n",
    "t0 = time.perf_counter()\n",
    "greedy_big = greedy_selection_generic(big_courses, big_akts, big_value, BIG_LIMIT)\n",
    "t_greedy = time.perf_counter() - t0\n",
    "\n",
    "t0 = time.perf_counter()\n",
    "prob_big = pulp.LpProblem(\"big_knapsack\", pulp.LpMaximize)\n",
    "x_big = {i: pulp.LpVariable(f\"x_{i}\", cat=\"Binary\") for i in big_courses}\n",
    "prob_big += pulp.lpSum(big_value[i] * x_big[i] for i in big_courses)\n",
    "prob_big += pulp.lpSum(big_akts[i] * x_big[i] for i in big_courses) <= BIG_LIMIT\n",
    "prob_big.solve(pulp.PULP_CBC_CMD(msg=0))\n",
    "t_ilp = time.perf_counter() - t0\n",
    "\n",
    "greedy_v = sum(big_value[i] for i in greedy_big)\n",
    "ilp_v    = int(pulp.value(prob_big.objective))\n",
    "\n",
    "print(f\"Greedy fayda : {greedy_v:4d}  ({t_greedy*1000:.1f} ms)\")\n",
    "print(f\"ILP fayda    : {ilp_v:4d}  ({t_ilp*1000:.1f} ms)\")\n",
    "print(f\"ILP kazancı  : {ilp_v - greedy_v}\")"
   ]
  }
 ]
}